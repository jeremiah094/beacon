# dependencies (npm workspaces hoists most of this to the root)
node_modules/
**/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env itself is committed (Supabase URL + publishable
# key are safe to ship client-side; RLS is the real gate). Only *.local
# overrides and anything holding real secrets stay untracked.
.env.local
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/apps/*/ios
/apps/*/android

# Supabase local dev
supabase/.branches
supabase/.temp
